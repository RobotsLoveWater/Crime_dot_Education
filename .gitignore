# Large source dataset (not distributed via git)
/dataset.sav

# Generated cache (includes a 200MB+ raw.csv) and per-user data
cache/
user/

# Educator portal: classes (rosters tie to real students, like user/)
classes/

# Local instance resets and the future consolidated runtime layout. Archives contain
# password hashes, rosters, and student activity and must never be committed.
instance/
instance-archives/

# uv migration Phase 0 reference freeze (throwaway snapshot, not a source of truth)
requirements.lock.txt

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv.bak/
.uv-cache/
venv/
env/

# uv: the environment (.venv/, above) is ignored, but the lockfile and Python pin are
# intentionally COMMITTED for reproducibility — do NOT add uv.lock or .python-version here.

# IDE
.idea/
.claude/settings.local.json
.claude/worktrees/

# Generated document/PDF previews and other disposable local output
tmp/
